79" end="00:48.097">nal</span><span begin="00:48.097" end="00:48.425">ly</span> <span begin="00:48.577" end="00:48.986">out</span> <span begin="00:48.986" end="00:49.222">of</span> <span begin="00:49.222" end="00:50.846">luck</span><span ttm:role="x-bg" begin="00:54.739" end="01:01.302"><span begin="00:54.739" end="00:54.941">(Fi</span><span begin="00:54.941" end="00:55.134">nal</span><span begin="00:55.134" end="00:55.479">ly</span> <span begin="00:55.669" end="00:56.084">out</span> <span begin="00:56.084" end="00:56.285">of</span> <span begin="00:56.285" end="01:01.302">luck)</span><span ttm:role="x-translation" xml:lang="zh-CN">终于运气耗尽</span></span><span ttm:role="x-translation" xml:lang="zh-CN">现在我终于运气耗尽</span></p><p begin="01:04.272" end="01:05.350" ttm:agent="v1" itunes:key="L16"><span begin="01:04.272" end="01:04.490">I've</span> <span begin="01:04.490" end="01:04.702">got</span> <span begin="01:04.702" end="01:04.912">a</span> <span begin="01:04.912" end="01:05.350">charm</span><span ttm:role="x-translation" xml:lang="zh-CN">我有一个护身符</span></p><p begin="01:05.545" end="01:09.188" ttm:agent="v1" itunes:key="L17"><span begin="01:05.545" end="01:05.764">I</span> <span begin="01:05.764" end="01:05.990">wan</span><span begin="01:05.990" end="01:06.224">na</span> <span begin="01:06.224" end="01:06.435">put</span> <span begin="01:06.435" end="01:06.657">it</span> <span begin="01:06.657" end="01:07.109">on</span> <span begin="01:07.109" end="01:07.522">your</span> <span begin="01:07.522" end="01:08.704">heart,</span> <span begin="01:08.704" end="01:09.188">yeah</span><span ttm:role="x-bg" begin="01:08.900" end="01:10.920"><span begin="01:08.900" end="01:09.104">(Fi</span><span begin="01:09.104" end="01:09.319">nal</span><span begin="01:09.319" end="01:09.575">ly</span> <span begin="01:09.765" end="01:10.203">out</span> <span begin="01:10.203" end="01:10.422">of</span> <span begin="01:10.422" end="01:10.920">luck)</span><span ttm:role="x-translation" xml:lang="zh-CN">终于运气耗尽</span></span><span ttm:role="x-translation" xml:lang="zh-CN">我想把它戴在你的心上</span></p><p begin="01:11.303" end="01:12.425" ttm:agent="v1" itunes:key="L18"><span begin="01:11.303" end="01:11.515">I</span> <span begin="01:11.515" end="01:11.738">wan</span><span begin="01:11.738" end="01:11.955">na</span> <span begin="01:11.955" end="01:12.425">cry</span><span ttm:role="x-translation" xml:lang="zh-CN">我想要哭泣</span></p><p begin="01:12.625" end="01:16.241" ttm:agent="v1" itunes:key="L19"><span begin="01:12.625" end="01:12.853">I</span> <span begin="01:12.853" end="01:13.053">wan</span><span begin="01:13.053" end="01:13.293">na</span> <span begin="01:13.293" end="01:13.495">mul</span><span begin="01:13.495" end="01:13.725">ti</span><span begin="01:13.725" end="01:14.182">ply</span> <span begin="01:14.182" end="01:14.597">more</span> <span begin="01:14.597" end="01:15.692">times,</span> <span begin="01:15.692" end="01:16.241">yeah</span><span ttm:role="x-bg" begin="01:15.973" end="01:17.915"><span begin="01:15.973" end="01:16.161">(Fi</span><span begin="01:16.161" end="01:16.367">nal</span><span begin="01:16.367" end="01:16.623">ly</span> <span begin="01:16.824" end="01:17.250">out</span> <span begin="01:17.250" end="01:17.472">of</span> <span begin="01:17.472" end="01:17.915">luck)</span><span ttm:role="x-translation" xml:lang="zh-CN">终于运气耗尽</span></span><span ttm:role="x-translation" xml:lang="zh-CN">我想无数次地重演</span></p><p begin="01:18.352" end="01:19.492" ttm:agent="v1" itunes:key="L20"><span begin="01:18.352" end="01:18.575">I've</span> <span begin="01:18.575" end="01:18.804">got</span> <span begin="01:18.804" end="01:19.030">a</span> <span begin="01:19.030" end="01:19.492">charm</span><span ttm:role="x-translation" xml:lang="zh-CN">我有一个护身符</span></p><p begin="01:19.710" end="01:23.394" ttm:agent="v1" itunes:key="L21"><span begin="01:19.710" end="01:19.907">I</span> <span begin="01:19.907" end="01:20.119">wan</span><span begin="01:20.119" end="01:20.359">na</span> <spa