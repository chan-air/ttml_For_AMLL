<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Look At The Sky (Live)"/><amll:meta key="artists" value="Porter Robinson"/><amll:meta key="album" value="Secret Sky 2021 (Live)"/><amll:meta key="ncmMusicId" value="1864859264"/><amll:meta key="ttmlAuthorGithub" value="235518886"/><amll:meta key="ttmlAuthorGithubLogin" value="chan-air"/></metadata></head><body dur="05:37.042"><div begin="01:07.957" end="05:37.042"><p begin="01:07.957" end="01:09.307" ttm:agent="v2" itunes:key="L0"><span begin="01:07.957" end="01:08.211">Is</span> <span begin="01:08.211" end="01:08.484">it</span> <span begin="01:08.484" end="01:09.307">fate</span><span ttm:role="x-translation" xml:lang="zh-CN">这是命运吗</span></p><p begin="01:11.861" end="01:15.253" ttm:agent="v2" itunes:key="L1"><span begin="01:11.861" end="01:12.095">If</span> <span begin="01:12.095" end="01:12.345">it’s</span> <span begin="01:12.345" end="01:12.594">not</span> <span begin="01:12.594" end="01:13.165">ea</span><span begin="01:13.165" end="01:13.426">sy</span> <span begin="01:13.426" end="01:13.678">it</span> <span begin="01:13.678" end="01:14.212">must</span> <span begin="01:14.212" end="01:14.735">not</span> <span begin="01:14.735" end="01:15.253">be</span><span ttm:role="x-translation" xml:lang="zh-CN">如果走投无路 那一定束手无策</span></p><p begin="01:16.287" end="01:17.852" ttm:agent="v2" itunes:key="L2"><span begin="01:16.287" end="01:16.528">At</span> <span begin="01:16.528" end="01:16.789">that</span> <span begin="01:16.789" end="01:17.589">a</span><span begin="01:17.589" end="01:17.852">ge</span><span ttm:role="x-translation" xml:lang="zh-CN">在那个年纪</span></p><p begin="01:19.928" end="01:23.619" ttm:agent="v2" itunes:key="L3"><span begin="01:19.928" end="01:20.183">I</span> <span begin="01:20.183" end="01:20.432">che</span><span begin="01:20.432" end="01:20.705">rished</span> <span begin="01:20.705" end="01:20.972">the</span> <span begin="01:20.972" end="01:21.515">flo</span><span begin="01:21.515" end="01:21.779">wers</span> <span begin="01:21.779" end="01:22.021">be</span><span begin="01:22.021" end="01:22.552">neath</span> <span begin="01:22.552" end="01:23.075">my</span> <span begin="01:23.075" end="01:23.619">feet</span><span ttm:role="x-translation" xml:lang="zh-CN">我曾珍惜脚下花朵</span></p><p begin="01:24.631" end="01:28.916" ttm:agent="v2" itunes:key="L4"><span begin="01:24.631" end="01:24.869">But</span> <span begin="01:24.869" end="01:25.427">then</span> <span begin="01:25.427" end="01:26.211">some</span><span begin="01:26.211" end="01:26.427">thing</span> <span begin="01:26.427" end="01:26.978">must</span> <span begin="01:26.978" end="01:27.480">have</span> <span begin="01:27.480" end="01:27.992">changed</span> <span begin="01:27.992" end="01:28.536">in</span> <span begin="01:28.536" end="01:28.916">me</span><span ttm:role="x-translation" xml:lang="zh-CN">而内心已百感交集</span></p><p begin="01:29.026" end="01:32.787" ttm:agent="v2" itunes:key="L5"><span begin="01:29.026" end="01:29.584">I</span> <span begin="01:29.584" end="01:30.100">used</span> <span begin="01:30.100" end="01:30.366">to</span> <span begin="01:30.366" end="01:30.942">feel</span> <span begin="01:30.942" end="01:31.417">so</span> <span begin="01:31.417" end="01:32.787">light</span><span ttm:role="x-translation" xml:lang="zh-CN">我曾感到如释重负</span></p><p begin="01:32.989" end="01:33.992" ttm:agent="v2" itunes:key="L6"><span begin="01:32.989" end="01:33.226">Now</span> <span begin="01:33.226" end="01:33.502">I’ll</span> <span begin="01:33.502" end="01:33.992">try</span><span ttm:role="x-translation" xml:lang="zh-CN">现在我会勇敢一试</span></p><p begin="01:36.624" end="01:39.266" ttm:agent="v2" itunes:key="L7"><span begin="01:36.624" end="01:36.887">I</span> <span begin="01:36.887" end="01:37.412">just</span> <span begin="01:37.412" end="01:38.466">want</span> <span begin="01:38.466" end="01:39.266">time</span><span ttm:role="x-translation" xml:lang="zh-CN">我只想分秒必争</span></p><p begin="01:42.108" end="01:43.710" ttm:agent="v1" itunes:key="L8"><span begin="01:42.108" end="01:42.929">Wait</span> <span begin="01:42.929" end="01:43.173">a</span><span begin="01:43.173" end="01:43.710">gain</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开</span></p><p begin="01:44.209" end="01:47.791" ttm:agent="v1" itunes:key="L9"><span begin="01:44.209" end="01:44.724">I</span> <span begin="01:44.724" end="01:45.230">will</span> <span begin="01:45.230" end="01:45.698">be</span> <span begin="01:45.698" end="01:46.241">much</span> <span begin="01:46.241" end="01:47.033">bet</span><span begin="01:47.033" end="01:47.279">ter</span> <span begin="01:47.279" end="01:47.791">then</span><span ttm:role="x-translation" xml:lang="zh-CN">我定会突破自我</span></p><p begin="01:48.401" end="01:51.454" ttm:agent="v1" itunes:key="L10"><span begin="01:48.401" end="01:49.156">Hol</span><span begin="01:49.156" end="01:49.391">ding</span> <span begin="01:49.391" end="01:50.273">on</span> <span begin="01:50.273" end="01:50.690">I</span> <span begin="01:50.690" end="01:51.454">said</span><span ttm:role="x-translation" xml:lang="zh-CN">坚持到底 我告诉自己</span></p><p begin="01:52.550" end="01:57.305" ttm:agent="v1" itunes:key="L11"><span begin="01:52.550" end="01:53.052">I</span> <span begin="01:53.052" end="01:53.583">will</span> <span begin="01:53.583" end="01:54.085">be</span> <span begin="01:54.085" end="01:54.630">much</span> <span begin="01:54.630" end="01:55.706">bet</span><span begin="01:55.706" end="01:56.758">ter</span> <span begin="01:56.758" end="01:57.305">then</span><span ttm:role="x-translation" xml:lang="zh-CN">我定会出类拔萃</span></p><p begin="01:59.900" end="02:03.598" ttm:agent="v1" itunes:key="L12"><span begin="01:59.900" end="02:00.170">Look</span> <span begin="02:00.170" end="02:00.427">at</span> <span begin="02:00.427" end="02:00.700">the</span> <span begin="02:00.700" end="02:01.280">sky</span> <span begin="02:01.280" end="02:02.010">I’m</span> <span begin="02:02.010" end="02:02.803">still</span> <span begin="02:02.803" end="02:03.598">here</span><span ttm:role="x-translation" xml:lang="zh-CN">仰望天空 我仍盈盈伫立</span></p><p begin="02:04.113" end="02:07.698" ttm:agent="v1" itunes:key="L13"><span begin="02:04.113" end="02:04.375">I’ll</span> <span begin="02:04.375" end="02:04.637">be</span> <span begin="02:04.637" end="02:04.897">a</span><span begin="02:04.897" end="02:06.170">live</span> <span begin="02:06.170" end="02:06.997">next</span> <span begin="02:06.997" end="02:07.698">year</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开 我光彩依旧 兴致盎然</span></p><p begin="02:08.230" end="02:12.641" ttm:agent="v1" itunes:key="L14"><span begin="02:08.230" end="02:08.432">I</span> <span begin="02:08.432" end="02:08.710">can</span> <span begin="02:08.710" end="02:09.245">make</span> <span begin="02:09.245" end="02:10.315">some</span><span begin="02:10.315" end="02:11.079">thing</span> <span begin="02:11.079" end="02:11.896">good</span> <span begin="02:12.132" end="02:12.641">oh</span><span ttm:role="x-bg" begin="02:13.187" end="02:16.036"><span begin="02:13.187" end="02:14.231">(Some</span><span begin="02:14.231" end="02:15.247">thing</span> <span begin="02:15.247" end="02:16.036">good)</span><span ttm:role="x-translation" xml:lang="zh-CN">满怀憧憬</span></span><span ttm:role="x-translation" xml:lang="zh-CN">我会创造美好事物</span></p><p begin="02:16.557" end="02:20.219" ttm:agent="v1" itunes:key="L15"><span begin="02:16.557" end="02:16.804">Look</span> <span begin="02:16.804" end="02:17.040">at</span> <span begin="02:17.040" end="02:17.324">the</span> <span begin="02:17.324" end="02:17.841">sky</span> <span begin="02:17.841" end="02:18.636">I’m</span> <span begin="02:18.636" end="02:19.440">still</span> <span begin="02:19.440" end="02:20.219">here</span><span ttm:role="x-translation" xml:lang="zh-CN">仰望天空 我仍盈盈伫立</span></p><p begin="02:20.724" end="02:24.215" ttm:agent="v1" itunes:key="L16"><span begin="02:20.724" end="02:20.991">I’ll</span> <span begin="02:20.991" end="02:21.254">be</span> <span begin="02:21.254" end="02:21.517">a</span><span begin="02:21.517" end="02:22.839">live</span> <span begin="02:22.839" end="02:23.900">next</span> <span begin="02:23.900" end="02:24.215">year</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开 我光彩依旧 兴致盎然</span></p><p begin="02:24.920" end="02:29.551" ttm:agent="v1" itunes:key="L17"><span begin="02:24.920" end="02:25.176">I</span> <span begin="02:25.176" end="02:25.416">can</span> <span begin="02:25.416" end="02:25.978">make</span> <span begin="02:25.978" end="02:27.011">some</span><span begin="02:27.011" end="02:27.773">thing</span> <span begin="02:27.773" end="02:28.586">good</span> <span begin="02:28.795" end="02:29.551">oh</span><span ttm:role="x-bg" begin="02:29.841" end="02:32.514"><span begin="02:29.841" end="02:30.919">(Some</span><span begin="02:30.919" end="02:31.943">thing</span> <span begin="02:31.943" end="02:32.514">good)</span><span ttm:role="x-translation" xml:lang="zh-CN">满怀憧憬</span></span><span ttm:role="x-translation" xml:lang="zh-CN">我会创造美好事物</span></p><p begin="02:33.555" end="02:35.034" ttm:agent="v2" itunes:key="L18"><span begin="02:33.555" end="02:33.799">Are</span> <span begin="02:33.799" end="02:34.046">you</span> <span begin="02:34.046" end="02:35.034">close</span><span ttm:role="x-translation" xml:lang="zh-CN">你会靠近吗</span></p><p begin="02:37.445" end="02:40.827" ttm:agent="v2" itunes:key="L19"><span begin="02:37.445" end="02:37.680">Shoul</span><span begin="02:37.680" end="02:37.933">dn’t</span> <span begin="02:37.933" end="02:38.196">it</span> <span begin="02:38.196" end="02:38.734">come</span> <span begin="02:38.734" end="02:39.003">to</span> <span begin="02:39.003" end="02:39.230">you</span> <span begin="02:39.230" end="02:39.788">na</span><span begin="02:39.788" end="02:40.299">tural</span><span begin="02:40.299" end="02:40.827">ly</span><span ttm:role="x-translation" xml:lang="zh-CN">这对你不是顺其自然的事吗</span></p><p begin="02:41.323" end="02:43.175" ttm:agent="v2" itunes:key="L20"><span begin="02:41.323" end="02:41.594">And</span> <span begin="02:41.594" end="02:41.834">e</span><span begin="02:41.834" end="02:42.105">very</span><span begin="02:42.105" end="02:42.374">one</span> <span begin="02:42.374" end="02:43.175">knows</span><span ttm:role="x-translation" xml:lang="zh-CN">世人皆知</span></p><p begin="02:45.534" end="02:49.173" ttm:agent="v2" itunes:key="L21"><span begin="02:45.534" end="02:45.795">You’re</span> <span begin="02:45.795" end="02:46.033">lo</span><span begin="02:46.033" end="02:46.292">sing</span> <span begin="02:46.292" end="02:46.563">your</span> <span begin="02:46.563" end="02:47.085">gift</span> <span begin="02:47.085" end="02:47.338">and</span> <span begin="02:47.338" end="02:47.613">it’s</span> <span begin="02:47.613" end="02:48.133">plain</span> <span begin="02:48.133" end="02:48.644">to</span> <span begin="02:48.644" end="02:49.173">see</span><span ttm:role="x-translation" xml:lang="zh-CN">显而易见的 你天赋渐失</span></p><p begin="02:50.220" end="02:54.410" ttm:agent="v2" itunes:key="L22"><span begin="02:50.220" end="02:50.458">But</span> <span begin="02:50.458" end="02:51.002">then</span> <span begin="02:51.002" end="02:51.793">some</span><span begin="02:51.793" end="02:52.042">thing</span> <span begin="02:52.042" end="02:52.547">must</span> <span begin="02:52.547" end="02:53.061">have</span> <span begin="02:53.061" end="02:53.618">changed</span> <span begin="02:53.618" end="02:54.143">in</span> <span begin="02:54.143" end="02:54.410">me</span><span ttm:role="x-translation" xml:lang="zh-CN">而我内心已百感交集</span></p><p begin="02:54.410" end="02:57.017" ttm:agent="v2" itunes:key="L23"><span begin="02:54.410" end="02:54.623">I</span> <span begin="02:54.623" end="02:55.195">don’t</span> <span begin="02:55.195" end="02:55.671">fear</span> <span begin="02:55.671" end="02:55.932">it</span> <span begin="02:55.932" end="02:56.195">a</span><span begin="02:56.195" end="02:56.460">ny</span><span begin="02:56.460" end="02:57.017">more</span><span ttm:role="x-translation" xml:lang="zh-CN">我不再恐惧</span></p><p begin="02:58.550" end="02:59.665" ttm:agent="v2" itunes:key="L24"><span begin="02:58.550" end="02:58.796">Now</span> <span begin="02:58.796" end="02:59.074">I’m</span> <span begin="02:59.074" end="02:59.665">sure</span><span ttm:role="x-bg" begin="03:02.741" end="03:04.051"><span begin="03:02.741" end="03:03.283">(I’m</span> <span begin="03:03.283" end="03:04.051">sure)</span><span ttm:role="x-translation" xml:lang="zh-CN">我敢确信</span></span><span ttm:role="x-translation" xml:lang="zh-CN">现在我确信</span></p><p begin="03:06.665" end="03:10.318" ttm:agent="v1" itunes:key="L25"><span begin="03:06.665" end="03:06.913">Look</span> <span begin="03:06.913" end="03:07.160">at</span> <span begin="03:07.160" end="03:07.428">the</span> <span begin="03:07.428" end="03:07.935">sky</span> <span begin="03:07.935" end="03:08.688">I’m</span> <span begin="03:08.688" end="03:09.528">still</span> <span begin="03:09.528" end="03:10.318">here</span><span ttm:role="x-translation" xml:lang="zh-CN">仰望天空 我仍盈盈伫立</span></p><p begin="03:10.825" end="03:14.436" ttm:agent="v1" itunes:key="L26"><span begin="03:10.825" end="03:11.135">I’ll</span> <span begin="03:11.135" end="03:11.348">be</span> <span begin="03:11.348" end="03:11.605">a</span><span begin="03:11.605" end="03:12.905">live</span> <span begin="03:12.905" end="03:13.708">next</span> <span begin="03:13.708" end="03:14.436">year</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开 我光彩依旧 兴致盎然</span></p><p begin="03:14.980" end="03:19.614" ttm:agent="v1" itunes:key="L27"><span begin="03:14.980" end="03:15.225">I</span> <span begin="03:15.225" end="03:15.492">can</span> <span begin="03:15.492" end="03:16.025">make</span> <span begin="03:16.025" en